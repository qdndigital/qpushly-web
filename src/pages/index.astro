---
import Base from '../layouts/Base.astro';
import NotifCard from '../components/NotifCard.astro';
import { APP_STORE_URL, INTRO_YOUTUBE_ID, INTRO_YOUTUBE_URL, INTRO_POSTER } from '../consts';
import { PLANS, PAYMENT_TRIAL_DAYS } from '../plans';

// Home, 2026-11 redesign. Same family tokens as the rest of the site; the new
// sections are styled in src/styles/v2.css. Every notification shown is from a
// fictional store, and every figure in the ledger is labelled illustrative — no
// performance claims anywhere on this page (see README → Claims discipline).

const journey = [
  {
    day: 'Monday', at: '14:02',
    title: 'Subscribes from your invite',
    did: 'She browses the autumn edit, sees your invite after a few seconds and taps Allow. No form, nothing to confirm.',
    tag: 'Welcome', plan: 'Free plan',
    n: { title: 'Welcome to Northline', body: 'New arrivals land every Thursday. Here’s 10% off your first order.', time: '14:03', buttons: ['Shop new in'] },
  },
  {
    day: 'Monday', at: '15:10',
    title: 'Leaves an overshirt in the cart',
    did: 'The cart goes quiet. An hour later — the delay you chose — the first of up to three reminders goes out.',
    tag: 'Abandoned cart', plan: 'Pro',
    n: { title: 'Still thinking it over?', body: 'Your Alder Overshirt is waiting. Free returns for 30 days.', time: '16:10', buttons: ['Back to cart', 'Not now'] },
  },
  {
    day: 'Wednesday', at: '→ Friday',
    title: 'Looks at a mug that is sold out',
    did: 'QPushly remembers the variant she wanted. When Shopify reports it back in stock on Friday, she hears first.',
    tag: 'Back in stock', plan: 'Pro',
    n: { title: 'Back in stock: Kiln Mug, Slate', body: 'The colour you looked at is available again.', time: 'Fri 09:41', buttons: ['Shop it'] },
  },
  {
    day: 'Saturday', at: '10:15',
    title: 'A tote she viewed gets cheaper',
    did: 'You cut the price by 5% or more. Only the people who looked at it at the old price are told.',
    tag: 'Price drop', plan: 'Pro',
    n: { title: 'Price drop on something you viewed', body: 'Harbour Canvas Tote is now $38.', time: '10:15', buttons: ['See it'] },
  },
  {
    day: 'Sunday', at: '09:00',
    title: 'Your weekend campaign goes out',
    did: 'Written on Thursday, scheduled for Sunday morning, sent to every subscriber — in two versions, to see which one gets the clicks.',
    tag: 'Campaign · A/B split test', plan: 'Free plan',
    n: { title: 'The weekend sale is on', body: '20% off outerwear until Sunday midnight.', time: '09:00', buttons: ['Shop the sale'] },
  },
];

// Illustrative, fictional store — labelled as such in the UI.
const ledger = [
  ['#1061', 'The weekend sale is on', 'Campaign · version B', '$84.00'],
  ['#1062', 'Abandoned cart · reminder 1', 'Cart tag', '$129.00'],
  ['#1063', 'Back in stock: Kiln Mug', 'Buy it now', '$32.00'],
  ['#1064', 'Welcome to Northline', 'Cart tag', '$57.50'],
];

const faqs = [
  [
    'Can I test two versions of a campaign?',
    'Yes. Switch a campaign to A/B split test and write two versions — title, message, image and link can all differ. Subscribers are split between them, and each version reports its own impressions, clicks, orders and revenue.',
  ],
  [
    'Do shoppers have to give an email address?',
    'No. A small invite from your store appears first — your words, your position, after a delay you choose. If the shopper accepts it, the browser asks once and they are subscribed. No form, no email address, no phone number, nothing to type. The browser’s own prompt never fires on page load, so you never spend a visitor’s one chance to say yes before they are interested.',
  ],
  [
    'Which browsers and devices can receive the notifications?',
    'Chrome, Edge, Firefox and Opera on Windows, macOS, Linux and Android. Safari on macOS is supported. On iPhone and iPad, web push only works if the shopper has added your store to their home screen — Apple requires an installed web app. QPushly records the browser, OS and device for every subscriber so you can see the mix in your own list.',
  ],
  [
    'What do I have to do to install it?',
    'Install from the Shopify App Store, then enable the QPushly app embed in your theme (Online Store → Themes → Customize → App embeds). That second step is not optional — the embed is what registers the service worker on your storefront. The whole thing takes a couple of minutes and needs no code.',
  ],
  [
    'Will this slow my storefront down?',
    'The embed adds three small deferred scripts. They do not block rendering, and the service worker only runs when the browser has idle time. No external tracker, no third-party geolocation lookup, no font or CSS request from another origin.',
  ],
  [
    'How does QPushly know a cart was abandoned?',
    'For subscribers, the embed sends a snapshot of the cart whenever it changes. If their cart goes quiet for ten minutes, the abandoned-cart automation starts its sequence: up to three reminders, each on the delay you set. When the order comes in, the cart is closed and any reminders still waiting are cancelled, and the sale is credited to the reminder that was clicked.',
  ],
  [
    'Can I import a subscriber list?',
    'Yes, on Pro — Import subscribers takes a CSV with each subscriber’s push endpoint and keys, and reports how many rows were imported, updated and skipped. One thing to know before switching providers: a browser subscription is tied to the push key it was created with, so subscribers collected by another app usually cannot be messaged from QPushly and need to opt in again from your invite.',
  ],
  [
    'What data does QPushly store about my shoppers?',
    'For subscribers: the push endpoint and its keys, browser, OS, device, language and timezone, and — only when an attributed order carries them — name, email, phone, city and country. It also stores cart contents and viewed products so the automations can reference them. All of it is deleted when you uninstall and Shopify sends the shop-redact request. See the Privacy Policy for the full list.',
  ],
];
---

<Base
  title="QPushly — One tap, always reachable. Web push for Shopify"
  description="Web push for Shopify stores. Shoppers subscribe in one tap — no email, no phone number — and campaigns plus five automations bring them back for abandoned carts, restocks and price drops, with revenue credited to each send."
>
  <!-- ─────────────────────────── HERO ─────────────────────────── -->
  <section class="hx" id="hx">
    <div class="wrap hx-grid">
      <div class="hx-copy">
        <h1>One tap, always reachable<span class="dot">.</span></h1>
        <p class="v2-lead">
          Web push for Shopify. A shopper taps Allow once — no email, no phone
          number — and your store can bring them back any time, even after they
          close the browser. Campaigns, five automations, and the revenue each
          send earned.
        </p>
        <div class="hx-cta">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Install free</a>
          <a href="#watch" class="btn btn-line btn-lg">Watch the 1-minute intro</a>
        </div>
        <div class="hx-meta">
          <span>Free plan, no time limit</span>
          <span>Pro has a {PAYMENT_TRIAL_DAYS}-day trial</span>
          <span>Any Shopify theme</span>
        </div>
      </div>

      <div class="hx-phone" aria-hidden="true">
        <div class="hx-screen">
          <span class="island"></span>
          <p class="clock">9:41</p>
          <p class="date">Friday 14 November</p>
          <NotifCard dark title="Back in stock: Kiln Mug, Slate" body="The colour you looked at is available again." time="now" />
          <NotifCard dark title="Price drop on something you viewed" body="Harbour Canvas Tote is now $38." time="Wed" />
          <NotifCard dark title="Still thinking it over?" body="Your Alder Overshirt is waiting in your cart." time="Mon" />
        </div>
      </div>

      {/* A storefront with the real invite (same wording and look as the theme
          embed's defaults — extensions/qpushly/assets/qpushly.css). */}
      <div class="hx-stage" aria-hidden="true">
        <div class="hx-store">
          <div class="hx-bar"><i></i><i></i><i></i><b>northline-supply.com</b></div>
          <div class="hx-nav"><strong>Northline Supply</strong><span>New in</span><span>Outerwear</span><span>Home</span><span>Sale</span></div>
          <div class="hx-shop">
            <div class="feat"><p>Autumn edit</p><h3>Layers for the<br />cold months</h3><span class="cta">Shop the edit</span></div>
            <div class="prod"></div><div class="prod"></div><div class="prod"></div><div class="prod"></div>
          </div>
          <div class="hx-invite">
            <span class="x">×</span>
            <p class="t">Get notified?</p>
            <p class="m">We'll let you know about restocks, price drops and new arrivals.</p>
            <div class="a"><span class="yes">Allow notifications</span><span class="no">Not now</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── JOURNEY ────────────────────────── -->
  <section class="v2-sec">
    <div class="wrap">
      <div class="v2-head split rv">
        <h2 class="v2-h2">What happens after someone taps Allow</h2>
        <p class="v2-lead">One shopper, one week at a fictional store. Every notification below is sent by QPushly on its own — you write it once and switch it on.</p>
      </div>
      <ol class="jr">
        {journey.map((j) => (
          <li class="rv">
            <div class="when"><b>{j.day}</b>{j.at}</div>
            <div>
              <h3>{j.title}</h3>
              <p class="did">{j.did}</p>
              <span class="tag">{j.tag} <i>{j.plan}</i></span>
            </div>
            <NotifCard {...j.n} />
          </li>
        ))}
      </ol>
      <p class="jr-foot v2-note">
        Browse abandonment, the fifth automation, follows up on a product someone
        looked at and left without adding to the cart. <a href="/automations" class="underline underline-offset-2">All five automations</a>
      </p>
    </div>
  </section>

  <!-- ───────────────────────── ADMIN ──────────────────────────── -->
  <section class="v2-sec paper">
    <div class="wrap ad">
      <div class="rv">
        <h2 class="v2-h2">It all happens inside your Shopify admin</h2>
        <p class="v2-lead">An embedded app: same navigation and components as the rest of Shopify. Nothing separate to log into.</p>
        <ul class="ad-list" style="margin-top:32px">
          <li><h3>Campaigns</h3><p>Title, message, image, link and audience. Preview it, send now or schedule it, and split-test two versions.</p></li>
          <li><h3>Automations</h3><p>Five of them, each with up to three reminders on delays you set, its own copy and buttons, and its own numbers.</p></li>
          <li><h3>Subscribers</h3><p>Growth over 7 to 60 days, segments by browser, OS and device, CSV export, and CSV import on Pro.</p></li>
        </ul>
      </div>
      <div class="ad-shots rv">
        <figure class="ad-shot back">
          <img src="/assets/screens/campaign.jpg" alt="QPushly campaign editor with title, message, link, image and live preview" width="1208" height="880" loading="lazy" decoding="async" />
          {/* The back window cycles through the other editors (CSS, v2.css "admin cycle"). */}
          <img class="cyc c2" src="/assets/screens/automations.jpg" alt="" width="1208" height="880" loading="lazy" decoding="async" />
          <img class="cyc c3" src="/assets/screens/reminder.jpg" alt="" width="1208" height="880" loading="lazy" decoding="async" />
        </figure>
        <figure class="ad-shot front"><img src="/assets/screens/subscribers.jpg" alt="QPushly subscribers page with a 30-day growth chart" width="1208" height="790" loading="lazy" decoding="async" /></figure>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── WATCH ──────────────────────────── -->
  {/* Same cut as the App Store listing video, hosted on YouTube. A poster
      stands in until someone presses play, so nothing loads from YouTube on
      page view; the chapter buttons start the video at that point. Without JS
      the poster is a plain link to the video. */}
  <section class="v2-sec" id="watch">
    <div class="wrap watch-grid">
      <div class="rv">
        <h2 class="v2-h2">See it end to end in one minute</h2>
        <p class="v2-lead">The invite on a storefront, a campaign going out, three automations firing, and the revenue each one brought back.</p>
        <ol class="watch-chapters">
          <li><button type="button" data-yt-start="10"><span>0:10</span>One-tap opt-in</button></li>
          <li><button type="button" data-yt-start="20"><span>0:20</span>Write and schedule a campaign</button></li>
          <li><button type="button" data-yt-start="31"><span>0:31</span>Five automations</button></li>
          <li><button type="button" data-yt-start="44"><span>0:44</span>Revenue per send</button></li>
        </ol>
        <p class="watch-yt"><a href={INTRO_YOUTUBE_URL} target="_blank" rel="noopener">Watch on YouTube ↗</a></p>
      </div>
      <div class="watch-frame rv" id="yt-intro" data-yt-id={INTRO_YOUTUBE_ID}>
        <a class="watch-poster" href={INTRO_YOUTUBE_URL} target="_blank" rel="noopener" aria-label="Play the QPushly intro, one minute, with voice-over">
          <img src={INTRO_POSTER} alt="" width="1600" height="900" loading="lazy" decoding="async" />
          <span class="watch-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
          <span class="watch-len" aria-hidden="true">1:00</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ─────────────────────── ATTRIBUTION ──────────────────────── -->
  <section class="v2-sec band">
    <div class="wrap at">
      <div class="rv">
        <h2 class="v2-h2">Every order is credited once, to the send that earned it</h2>
        <ol class="at-steps">
          <li>A click carries the notification’s tag into the cart — or, for “Buy it now”, into the moment the button is pressed.</li>
          <li>Shopify reports the order. QPushly matches it to that campaign, A/B version or reminder.</li>
          <li>Edits and refunds re-send the order. It is still counted once.</li>
        </ol>
      </div>
      <div class="ledger rv">
        <div class="ledger-h"><b>Attributed orders</b><span>Illustrative store</span></div>
        <table>
          <thead><tr><th>Order</th><th>Credited to</th><th class="num">Revenue</th></tr></thead>
          <tbody>
            {ledger.map(([ord, src, via, rev]) => (
              <tr><td class="ord">{ord}</td><td><span class="src">{src}</span><span class="via">{via}</span></td><td class="num">{rev}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── SETUP ──────────────────────────── -->
  <section class="v2-sec">
    <div class="wrap">
      <div class="v2-head split rv">
        <h2 class="v2-h2">Live in about two minutes, no developer</h2>
        <p class="v2-lead">Ready-written reminders for all five automations come with the install, switched off until you have read them.</p>
      </div>
      <ol class="su rv">
        <li><span class="n">1</span><h3>Install from the App Store</h3><p>QPushly appears in your admin like any other embedded app.</p></li>
        <li><span class="n">2</span><h3>Turn on the theme embed</h3><p>Online Store → Themes → Customize → App embeds → QPushly → Save. The dashboard checklist links straight there.</p></li>
        <li><span class="n">3</span><h3>Switch on welcome</h3><p>Open your storefront, accept the invite, and you are your own first subscriber.</p></li>
      </ol>
    </div>
  </section>

  <!-- ──────────────────────── PRICING ─────────────────────────── -->
  <section class="v2-sec sky">
    <div class="wrap">
      <div class="v2-head split rv">
        <h2 class="v2-h2">Start free. Pay when push is earning.</h2>
        <p class="v2-lead">Billed by Shopify on your normal invoice. Change or cancel from the app at any time. <a href="/pricing" class="underline underline-offset-2">Compare plans</a></p>
      </div>
      <div class="pr rv">
        {PLANS.map((p) => (
          <div class={`pr-card${p.feat ? ' hi' : ''}`}>
            <h3>{p.name}</h3>
            <p class="p"><b>{p.price}</b><span>{p.price === '$0' ? 'no time limit' : 'every 30 days'}</span></p>
            <p class="d">{p.desc}</p>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            <a href={APP_STORE_URL} class={`btn ${p.feat ? 'btn-accent' : 'btn-line'}`}>
              {p.price === '$0' ? 'Install free' : `Start ${PAYMENT_TRIAL_DAYS}-day trial`}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ────────────────────────── FAQ ───────────────────────────── -->
  <section class="v2-sec">
    <div class="wrap">
      <div class="v2-head rv"><h2 class="v2-h2">Questions merchants ask first</h2></div>
      <div class="faq rv">
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}<span class="pm"></span></summary>
            <p class="ans">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ────────────────────────── CTA ───────────────────────────── -->
  <section class="v2-sec" style="padding-top:0">
    <div class="wrap">
      <div class="end rv">
        <div>
          <h2>Ask for a tap, not an email address.</h2>
          <p>Install QPushly, turn on the theme embed, and start building a list from the traffic you already have.</p>
          <div class="hx-cta">
            <a href={APP_STORE_URL} class="btn btn-lg btn-light">Install free</a>
            <a href="#watch" class="btn btn-lg btn-dk">Watch the intro</a>
          </div>
        </div>
        <div class="stack" aria-hidden="true">
          <NotifCard dark title="Price drop on something you viewed" body="Harbour Canvas Tote is now $38." time="now" />
          <NotifCard dark title="Still thinking it over?" body="Your Alder Overshirt is waiting in your cart." time="1h ago" />
        </div>
      </div>
    </div>
  </section>
</Base>
