---
// Qpushly mark — the real brand symbol (a rounded "Q" with the blue notification chip),
// copied from the app's brand kit (qpushly/public/brand/qpushly-symbol.svg). Keeping one
// component means the header, footer and any future placement can never drift apart.
// The viewBox is the glyph's own bounds, so the mark sits flush in its box.
const { class: cls = 'logomark' } = Astro.props;
