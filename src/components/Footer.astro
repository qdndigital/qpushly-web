---
import Logo from './Logo.astro';
import { SUPPORT_EMAIL, APP_STORE_URL, GUIDE_URL } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="wrap">
    <div class="foot">
      <div>
        <a href="/" class="logo" aria-label="QPushly home">
          <Logo />
        </a>
        <p class="fd tagline">One tap, always reachable<span class="dot">.</span></p>
        <p class="fd">Web push notifications for Shopify. Shoppers opt in with one tap — no email, no phone number — and every send reports what it brought back.</p>
      </div>
      <div>
        <h2>Product</h2>
        <a href="/automations">Automations</a>
        <a href="/how-it-works">How it works</a>
        <a href="/integrations">Integrations</a>
        <a href="/pricing">Pricing</a>
        <a href={GUIDE_URL}>User guide</a>
      </div>
      <div>
        <h2>Company</h2>
        <a href="/support">Support</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href={`mailto:${SUPPORT_EMAIL}`}>Contact</a>
      </div>
      <div>
        <h2>Get started</h2>
        <a href={APP_STORE_URL}>Shopify App Store</a>
        <a href="/#watch">Watch the 1-minute intro</a>
      </div>
    </div>
    <div class="fbar">
      <span>© {year} QDN. All rights reserved.</span>
      <span>QPushly is a Shopify app by QDN.</span>
    </div>
  </div>
</footer>
